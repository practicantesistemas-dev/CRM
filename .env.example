# Variables leídas por docker-compose.yml (copiar a ".env" en esta misma carpeta y completar).
# No confundir con backend_crm_mercadeo/.env ni frontend/.env, que son otro archivo cada uno.

# Puertos publicados en el host. Antes de desplegar, verifica en el servidor que están libres:
#   docker ps --format "table {{.Names}}\t{{.Ports}}"
#   ss -tulpn | grep -E ":(8090|8100)\b"
# y cambia el valor acá si alguno ya está en uso por otro proyecto.
CRM_FRONTEND_PORT=8090
CRM_BACKEND_PORT=8100

# URL pública del backend Login/SSO. Vacío = usa el /api/auth/login propio de este backend
# (proxeado same-origin por nginx, ver frontend/nginx.conf), para poder loguearte en local
# con docker-compose sin depender del portal externo ni de puertos extra en el host.
# Producción (login centralizado contra el portal):
# VITE_PORTAL_PRINCIPAL_URL=http://160.2.1.80:3000
# Local (docker-compose en tu propia máquina):
VITE_PORTAL_PRINCIPAL_URL=

# Credenciales de Tableau embebido (opcional, solo si se usa esa vista).
VITE_TABLEAU_CLIENT_ID=
VITE_TABLEAU_SECRET_ID=
VITE_TABLEAU_SECRET_VALUE=
VITE_TABLEAU_USERNAME=
